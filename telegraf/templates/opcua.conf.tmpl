# Per-pipeline Telegraf config, rendered by task_manager at pipeline-create time.
# Do not edit a rendered copy — edit this template.
#
# Placeholders are substituted by common/app_common/telegraf_config.py, which
# pre-quotes every value as a TOML basic string. Keep placeholders unquoted here.

[agent]
  interval = "$interval"
  flush_interval = "$flush_interval"
  metric_batch_size = $metric_batch_size
  metric_buffer_limit = $metric_buffer_limit
  omit_hostname = true

# execd, not exec: the connector holds an open OPC UA subscription and streams.
# exec would run it on a schedule and silently miss everything between runs.
[[inputs.execd]]
  command = $command
  environment = $environment
  # The connector exits on any connection or session failure by design; this is
  # what brings it back, and it is what replaces the watchdog's restart.
  restart_delay = "$restart_delay"
  signal = "none"

  data_format = "json"
  json_time_key = "event_time"
  json_time_format = "$time_format"
  tag_keys = ["pipeline_id", "sensor", "source", "quality", "node_id"]
  # "value" is listed so a non-numeric reading (MachineStatus = "RUNNING") is
  # kept as a string field. Without it Telegraf's JSON parser silently drops
  # every non-numeric value.
  json_string_fields = ["value"]
  name_override = "$measurement"

[[outputs.kafka]]
  brokers = $brokers
  topic = $topic
  # Telegraf routes every input to every output. Without this, inputs.internal's
  # own metrics are published to the pipeline's topic and land as rows in its
  # ClickHouse table — plausible-looking garbage with current timestamps, which
  # also makes a stalled source look alive.
  namepass = [$measurement_name]
  data_format = "json"
  # Telegraf emits timestamps in SECONDS unless told otherwise. The consumer
  # pool reads them as milliseconds, so without this every record lands with an
  # event_time near 1970 — silently, since the values themselves are fine.
  json_timestamp_units = "1ms"
  compression_codec = 0
  required_acks = -1
  max_retry = 3

# Telegraf's own metrics — input/output counts, execd subprocess restarts, write
# errors. This is how Prometheus sees a producer at all; the connector itself
# serves only /healthz for kubelet.
[[outputs.prometheus_client]]
  listen = ":$METRICS_PORT"
  metric_version = 2
  path = "/metrics"
  # Mirror of the kafka output's namepass: only Telegraf's own metrics here,
  # never the pipeline's data.
  namedrop = [$measurement_name]

[[inputs.internal]]
  collect_memstats = false
