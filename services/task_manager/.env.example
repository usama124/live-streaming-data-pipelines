# ════════════════════════════════════════════════════════════════════════════
#  Data Platform — Task Manager · shared .env template
#  Read by: task-manager, controller, watchdog
#  Copy to .env (`cp .env.example .env`) and edit. Every variable maps 1-to-1
#  to a field in common/app_common/config.py.
# ════════════════════════════════════════════════════════════════════════════

# ── Infrastructure ────────────────────────────────────────────────────────────
# Service names resolve on the data-platform_backend network created by the root
# docker-compose.yml. For infrastructure running outside Compose, use
# host.docker.internal (extra_hosts already maps it) — never a bridge gateway IP,
# it changes per machine.

REDIS_URL=redis://redis:6379/2
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Runtime ───────────────────────────────────────────────────────────────────
# docker     → manages producer/consumer as Docker containers (local dev)
# redis_only → no containers, state in Redis only (unit tests)
# DOCKER_NETWORK must name the network pipeline containers join — the same one
# kafka/clickhouse are on, or they are unreachable.

RUNTIME_MODE=docker
DOCKER_NETWORK=data-platform_backend
PRODUCER_IMAGE=data-platform-producer:latest
CONSUMER_IMAGE=data-platform-consumer:latest

# ── ClickHouse ────────────────────────────────────────────────────────────────
# Passed through as env vars into every consumer container at launch time

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=data_platform
CLICKHOUSE_TABLE=pipeline_events

# ── Airflow ───────────────────────────────────────────────────────────────────
# Normal/batch pipelines are out of this repo's scope — leave disabled.

AIRFLOW_ENABLED=false

# ── Folder watcher (task-manager) ─────────────────────────────────────────────
# Drop a <pipeline_id>.json file into this directory to register a new pipeline.
# The watcher picks it up, registers in Redis, moves file to processed/.

PIPELINE_DEFINITIONS_DIR=/opt/pipeline_definitions
WATCHER_POLL_INTERVAL_S=5.0
WATCHER_ENABLED=true

# ── Desired-state controller ──────────────────────────────────────────────────
# How often (seconds) the reconcile loop scans all pipelines for state drift.
# Deleted in Phase 3, when Kubernetes owns reconciliation.

CONTROLLER_INTERVAL_S=3

# ── Watchdog ──────────────────────────────────────────────────────────────────
# WATCHDOG_HEARTBEAT_TIMEOUT_S: seconds without a heartbeat before restart.
# Producer/consumer write heartbeat every ~5s → 30s = 6 missed beats.

WATCHDOG_INTERVAL_S=15
WATCHDOG_HEARTBEAT_TIMEOUT_S=30
