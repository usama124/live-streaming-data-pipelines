# ── Core ──────────────────────────────────────────────────────────────────────
pipeline_id=123456789
source_type=opcua
redis_url=redis://localhost:6379/2
kafka_bootstrap_servers=localhost:9092
kafka_topic=123456789

heartbeat_interval_seconds=5

# ── OPC UA ────────────────────────────────────────────────────────────────────
# Address of the OPC UA server (mock or real)
opcua_endpoint=opc.tcp://localhost:4840/stratahub/server/

# Comma-separated NodeID strings — browse with UaExpert or asyncua's browse API
# to discover the correct IDs for your server.  The mock server uses ns=2;i=N.
opcua_node_ids=ns=2;i=2,ns=2;i=3,ns=2;i=4,ns=2;i=5,ns=2;i=6

# Optional: human-readable labels per NodeID (JSON, no spaces)
opcua_node_names_json={"ns=2;i=2":"Temperature","ns=2;i=3":"Pressure","ns=2;i=4":"Vibration","ns=2;i=5":"FlowRate","ns=2;i=6":"MachineStatus"}

# How often the OPC UA server should push batched change notifications (ms).
# Lower = more responsive, higher = less network overhead.
opcua_publishing_interval_ms=500

# Reconnect backoff: starts at base_s, doubles each attempt, caps at max_s.
opcua_reconnect_base_s=2.0
opcua_reconnect_max_s=60.0

# Max buffered events before back-pressure drops the oldest.
opcua_queue_maxsize=1000
